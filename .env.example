STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org

CONTRACT_ESCROW=YOUR_CONTRACT_ESCROW_ID_HERE
CONTRACT_ORACLE=YOUR_CONTRACT_ORACLE_ID_HERE

LICHESS_API_TOKEN=YOUR_LICHESS_TOKEN_HERE
CHESSDOTCOM_API_KEY=YOUR_CHESSDOTCOM_API_KEY_HERE

# JWT Secret for signing and verifying authentication tokens
# REQUIRED: Must be a strong, random string. Generate with: openssl rand -base64 32
# Never commit a real value to version control; load from a secrets manager in production
# Used to sign JWT tokens for API authentication on mutating endpoints (POST, PUT, PATCH, DELETE)
JWT_SECRET=YOUR_JWT_SECRET_HERE

# Oracle signing key — never commit a real value; load from a secrets manager in production
ORACLE_SECRET_KEY=YOUR_ORACLE_SECRET_KEY_HERE

# Comma-separated list of allowed CORS origins
# e.g. https://app.example.com,https://staging.example.com
# Falls back to FRONTEND_URL if set, otherwise defaults to http://localhost:5173
ALLOWED_ORIGINS=
FRONTEND_URL=

# Persistent Job Queue Configuration
# QUEUE_STORE: Storage backend for the oracle dead-letter queue (DLQ)
#   - 'auto' (default): resolves to SQLite, a durable file-based store
#   - 'sqlite': Use SQLite with file-based persistence (same as auto)
#   - 'mongodb': not currently available (the mongoose dependency is not
#     installed); requests fall back to SQLite with a startup warning
#   - 'memory': In-memory storage (development only, data lost on restart).
#     NEVER use in production -- if NODE_ENV=production, this is
#     auto-corrected to sqlite. See docs/oracle.md#queue-store-persistence.
QUEUE_STORE=auto

# MongoDB URL for persistent queue storage (currently unused, see QUEUE_STORE above)
# Format: mongodb://user:password@host:port/database
# Example: mongodb://localhost:27017/smile4money
MONGODB_URL=

# DLQ_TTL_DAYS: how many days a dead-letter queue entry is kept before a
# background task evicts it. Defaults to 7 when unset or invalid.
# See docs/oracle.md#dlq-ttl-eviction.
DLQ_TTL_DAYS=7

# Rate Limiting Configuration
# Lichess API: Official limit is 60 req/min. We use 30 req/60s for safety.
# Configure with environment variables or use defaults below.
LICHESS_RATE_LIMIT=30
LICHESS_RATE_PERIOD_MS=60000

# Chess.com API: Limits are undocumented. Conservative approach: 20 req/60s
# Note: Chess.com may use IP-based rate limiting; adjust if needed.
CHESSDOTCOM_RATE_LIMIT=20
CHESSDOTCOM_RATE_PERIOD_MS=60000

# Game Polling Configuration
# POLLING_INTERVAL_MS: how often (in milliseconds) the backend polls each
# active match's chess-platform API for a result. Defaults to 30000 (30s)
# when unset. Must be a positive number — a non-numeric, zero, or negative
# value fails startup with a clear error rather than silently mis-polling.
# See docs/oracle.md#polling-interval-and-job-scheduling for how this
# interacts with MAX_POLLING_ATTEMPTS and POLLING_BACKOFF_MULTIPLIER.
POLLING_INTERVAL_MS=30000

VITE_STELLAR_NETWORK=testnet
VITE_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
